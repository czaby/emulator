variable "aws_region" {
  type        = string
  description = "AWS Region to deploy into."
  default     = "us-east-1"
}

variable "aws_endpoint" {
  type        = string
  description = "Unused by the default provider block in providers.tf. Consumed only when ci/emulator_override.tf has been copied into this directory for an AWS Emulator run."
  default     = "https://127.0.0.1:9297"
}

variable "insecure_skip_tls_verify" {
  type        = bool
  description = "Unused by the default provider block in providers.tf. Consumed only when ci/emulator_override.tf has been copied into this directory. Leave false locally when trusting ca.pem via AWS_CA_BUNDLE. Set true in GitLab CI because the emulator certificate is issued for 127.0.0.1, while the job reaches the service as aws-emulator."
  default     = false
}

variable "availability_zones" {
  type        = list(string)
  description = "Two availability zones in var.aws_region, used by the DB subnet group and the ECS service. Override this when you change the region."
  default     = ["us-east-1a", "us-east-1b"]

  validation {
    condition     = length(var.availability_zones) >= 2
    error_message = "Provide at least two availability zones (RDS DB subnet groups require them)."
  }
}

variable "bucket_name" {
  type        = string
  description = "S3 bucket name. Must be globally unique if you apply this against real AWS."
  default     = "emulator-demo-bucket"
}

variable "table_name" {
  type        = string
  description = "DynamoDB table name."
  default     = "emulator-demo-table"
}

variable "vpc_cidr" {
  type        = string
  description = "CIDR block for the demo VPC."
  default     = "10.0.0.0/16"
}

variable "db_cluster_identifier" {
  type        = string
  description = "Identifier for the Aurora MySQL cluster."
  default     = "emulator-demo"
}

variable "db_name" {
  type        = string
  description = "Name of the initial database created on the Aurora cluster."
  default     = "demo"
}

variable "db_username" {
  type        = string
  description = "Master username for the Aurora cluster. The password is generated by random_password and is not written to outputs."
  default     = "admin"
}

variable "ecs_cluster_name" {
  type        = string
  description = "Name of the ECS cluster."
  default     = "emulator-demo"
}

variable "ecs_container_image" {
  type        = string
  description = "Container image for the Fargate task."
  default     = "public.ecr.aws/nginx/nginx:latest"
}

variable "sns_topic_name" {
  type        = string
  description = "SNS topic name."
  default     = "emulator-demo-topic"
}

variable "sqs_queue_name" {
  type        = string
  description = "SQS queue that subscribes to the SNS topic."
  default     = "emulator-demo-queue"
}
